{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "minecraft:campfire_smoke_particle",
			"basic_render_parameters": {
				"material": "alpha_blend",
				"texture": "textures/particle/campfire_smoke"
			}
		},
		"curves": {
			"variable.swept": {
				"type": "catmull_rom",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [0, 0, 0.34, 1.5, 5]
			}
		},
		"events": {
			"bloom": {
				"sequence": [
					{
						"particle_effect": {
							"effect": "zan:campfire_bloom",
							"type": "emitter"
						}
					},
					{
						"particle_effect": {
							"effect": "zan:campfire_bloom_soul",
							"type": "emitter"
						}
					}
				]
			}
		},
		"components": {
			"minecraft:emitter_rate_manual": {
				"max_particles": 200
			},
			"minecraft:emitter_lifetime_expression": {
				"activation_expression": 1
			},
			"minecraft:emitter_shape_point": {
				"direction": [0, 1, 0]
			},
			"minecraft:particle_initialization": {
				"per_render_expression": "variable.size = 0.75 + 3.5 * math.pow(variable.particle_age / variable.particle_lifetime, 1.5);"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 15
			},
			"minecraft:particle_lifetime_events": {
				"timeline": {
					"0.00": "bloom"
				}
			},
			"minecraft:particle_initial_speed": "Math.random(0.5, 1.0)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": ["v.swept", 0.28, "v.swept"]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["variable.size", "variable.size"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 1,
					"texture_height": 12,
					"uv": [0, "Math.floor(variable.particle_random_2 * 12)"],
					"uv_size": [1, 1]
				}
			},
			"minecraft:particle_motion_collision": {
				"enabled": "variable.particle_age > 1",
				"collision_radius": 0.25
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.14": "#FFBBBBBB",
						"0.33": "#ffffffff",
						"0.55": "#ffffffff",
						"0.97": "#00FFFFFF"
					}
				}
			}
		}
	}
}