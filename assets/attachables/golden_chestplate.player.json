{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "minecraft:golden_chestplate.player",
      "item": { "minecraft:golden_chestplate": "query.owner_identifier == 'minecraft:player'" },
      "materials": {
        "enchanted": "armor_enchanted",
        "default": "armor",
        "trim": "trim"
      },
      "textures": {
        "default": "textures/models/armor/blank",
        "enchanted": "textures/misc/enchanted_actor_glint",
        "armor": "textures/models/armor/gold_1"
      },
      "geometry": {
        "default": "geometry.player.armor.chestplate",
        "trim": "geometry.player.armor.chestplate.trim"
      },
      "scripts": {
        "parent_setup": "variable.chest_layer_visible = 0.0;",
        "animate": [
          "offset"
        ]
      },
      "animations": {
        "offset": "animation.armor.chestplate.offset"
      },
      "render_controllers": [ "controller.render.armor.player_default", {"controller.render.armor.player_trim": "v.has_trim"} ]
    }
  }
}
